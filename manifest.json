{
  "manifest_version": 3,
  "name": "Prompt Scrubber",
  "version": "1.1",
  "browser_specific_settings": { "gecko": { "id": "prompt-scrubber@manya.local", "strict_min_version": "140.0", "data_collection_permissions": { "required": ["none"] } } },
  "permissions": ["storage"],
  "content_scripts": [{ "matches": ["<all_urls>"], "all_frames": true, "run_at": "document_start", "js": ["content.js"] }],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "128": "icon.png" }
}
